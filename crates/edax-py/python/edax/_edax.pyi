        events: list[EventEnvelope],
    ) -> None: ...
    def load_snapshot(self, tx: int, aggregate_id: str) -> SnapshotResult | None: ...
    def save_snapshot(
        self,
        tx: int,
        aggregate_id: str,
        type_name: str,
        version: int,
        data: bytes,
    ) -> None: ...
    def unpublished(self, limit: int) -> list[EventEnvelope]: ...
    def unpublished_count(self) -> int: ...
    def mark_published(self, ids: list[str]) -> None: ...
    def claim(self, tx: int, key: str, payload_hash: int) -> MemoryClaim: ...
    def complete(self, tx: int, key: str, handle: bytes, record_json: str) -> None: ...
    def release(self, tx: int, key: str, handle: bytes) -> None: ...
    def expire_claim(self, key: str) -> bool: ...
    def get_projection(
        self,
        tx: int,
        id: str,  # noqa: A002
    ) -> ProjectionRow | None: ...
    def save_projection(
        self,
        tx: int,
        id: str,  # noqa: A002
        version: int,
        document_json: str,
    ) -> int: ...
    def query_projections(self, tx: int, query_json: str) -> str: ...
    def load_saga(
        self,
        tx: int,
        id: str,  # noqa: A002
    ) -> SagaRow | None: ...
    def save_saga(
        self,
        tx: int,
        id: str,  # noqa: A002
        version: int,
        state_json: str,
        folded: str,
        commands: list[SagaCommand],
    ) -> int: ...
    def complete_saga(
        self,
        tx: int,
        id: str,  # noqa: A002
        version: int,
        commands: list[SagaCommand],
    ) -> int: ...
    def unsent_saga_commands(self, limit: int) -> list[SagaCommand]: ...
    def mark_saga_commands_sent(self, ids: list[str]) -> None: ...
class OffsetTracker:
    def book(self, topic: str, partition: int, offset: int) -> int: ...
    def is_live(self, token: int) -> bool: ...
    def ack(self, token: int) -> bool: ...
    def due(self) -> list[KafkaDue]: ...
