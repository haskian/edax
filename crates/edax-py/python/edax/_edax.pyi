# Committed type stub for the alef-generated `_edax` extension (PEP 561, beside `_edax.abi3.so`
# + `py.typed`). Gives `edax.Event`/`edax.EventEnvelope` field types; the native classes have none.
# Copy of `crates/edax-py/.alef/_edax.pyi` with alef header stripped so alef cleanup leaves it.
# Refresh after an edax-abi shape change: `alef generate --lang python --clean`, then re-run this.

class EnvelopePage:
    items: list[EventEnvelope]
    def __init__(self, items: list[EventEnvelope]) -> None: ...

class Event:
    name: str
    version: int
    data: bytes
    def __init__(self, name: str, version: int, data: bytes) -> None: ...

class EventEnvelope:
    id: str
    aggregate_id: str
    event: Event
    sequence: int | None
    namespace: dict[str, str]
    metadata: dict[str, str]
    timestamp: int
    def __init__(
        self,
        id: str,  # noqa: A002
        aggregate_id: str,
        event: Event,
        namespace: dict[str, str],
        metadata: dict[str, str],
        timestamp: int,
        sequence: int | None = None,
    ) -> None: ...

class IdempotencyRecord:
    payload_hash: int
    state: str
    error: str
    result_json: str
    def __init__(self, payload_hash: int, state: str, error: str, result_json: str) -> None: ...

class PollResult:
    present: bool
    token: int
    envelope: EventEnvelope
    def __init__(self, present: bool, token: int, envelope: EventEnvelope) -> None: ...

class SnapshotResult:
    present: bool
    type_name: str
    version: int
    data: bytes
    def __init__(self, present: bool, type_name: str, version: int, data: bytes) -> None: ...

class SplitError:
    code: str
    message: str
    def __init__(self, code: str, message: str) -> None: ...

class MemoryBroker:
    def publish(self, envelope: EventEnvelope) -> None: ...
    def try_poll(self) -> PollResult: ...
    def ack(self, token: int) -> bool: ...
    def nack(self, token: int) -> bool: ...
    def is_empty(self) -> bool: ...
class MemoryTransactor:
    def begin(self) -> int: ...
    def commit(self, tx: int) -> None: ...
    def rollback(self, tx: int) -> bool: ...
    def open_count(self) -> int: ...
    async def load_events(self, tx: int, aggregate_id: str, after: int) -> EnvelopePage: ...
    async def append_events(
        self,
        tx: int,
        aggregate_id: str,
        expected_version: int,
        events: list[EventEnvelope],
    ) -> None: ...
    async def load_snapshot(self, tx: int, aggregate_id: str) -> SnapshotResult: ...
    async def save_snapshot(
        self,
        tx: int,
        aggregate_id: str,
        type_name: str,
        version: int,
        data: bytes,
    ) -> None: ...
    async def unpublished(self, limit: int) -> EnvelopePage: ...
    async def mark_published(self, ids: list[str]) -> None: ...
    async def claim(self, tx: int, key: str, payload_hash: int) -> str | None: ...
    async def complete(self, tx: int, key: str, record_json: str) -> None: ...
    async def release(self, tx: int, key: str) -> None: ...
    async def get_projection(
        self,
        tx: int,
        id: str,  # noqa: A002
    ) -> str | None: ...
    async def save_projection(
        self,
        tx: int,
        id: str,  # noqa: A002
        version: int,
        document_json: str,
    ) -> int: ...
    async def query_projections(self, tx: int, query_json: str) -> str: ...
    async def load_saga(
        self,
        tx: int,
        id: str,  # noqa: A002
    ) -> str | None: ...
    async def save_saga(
        self,
        tx: int,
        id: str,  # noqa: A002
        version: int,
        state_json: str,
    ) -> int: ...
    async def delete_saga(
        self,
        tx: int,
        id: str,  # noqa: A002
        version: int,
    ) -> None: ...

def backoff_millis(attempt: int) -> int: ...
def check_sequence_batch(expected: int, sequences: list[int | None]) -> None: ...
def current_timestamp() -> int: ...
def decode_envelope(
    format: str,  # noqa: A002
    wire: bytes,
) -> EventEnvelope: ...

def decode_idempotency_record(record_json: str) -> IdempotencyRecord: ...
def encode_cursor(doc: str, sort: str) -> str: ...
def encode_envelope(
    format: str,  # noqa: A002
    id: str,  # noqa: A002
    aggregate_id: str,
    event_name: str,
    event_version: int,
    event_data: bytes,
    namespace: dict[str, str],
    metadata: dict[str, str],
    timestamp: int,
    sequence: int | None = None,
) -> bytes: ...

def encode_idempotency_record(
    payload_hash: int,
    pending: bool,
    result_json: str,
    error: str | None = None,
) -> str: ...

def error_code_is_terminal(code: str) -> bool: ...
def error_codes() -> list[str]: ...
def eval_filter(
    filter: str,  # noqa: A002
    doc: str,
) -> bool: ...

def guid() -> str: ...
def idempotency_decision(current: int, prior: int | None = None) -> str: ...
def idempotency_outcome(
    current: int,
    payload_hash: int,
    pending: bool,
    error: str | None = None,
) -> str: ...

def memory_broker() -> MemoryBroker: ...
def memory_transactor() -> MemoryTransactor: ...
def no_tx() -> int: ...
def originate(metadata: dict[str, str], fresh_id: str) -> dict[str, str]: ...
def partition(aggregate_id: str, n: int) -> int: ...
def payload_hash(payload: bytes) -> int: ...
def payload_hash_json(payload: bytes) -> int: ...
def propagate(parent_metadata: dict[str, str], parent_event_id: str) -> dict[str, str]: ...
def query(query: str, docs: str) -> str: ...
def rendezvous(aggregate_id: str, n: int) -> int: ...
def should_apply(stored: int | None = None, incoming: int | None = None) -> bool: ...
def split_error(wire: str) -> SplitError: ...
def upcast_plan(from_version: int, to: int, available: list[int]) -> list[int]: ...
