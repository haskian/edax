class Retries:
    def max_attempts(self) -> int: ...
    def attempt(
        self,
        id: str,  # noqa: A002
        broker_attempt: int,
    ) -> int: ...
    def succeeded(
        self,
        id: str,  # noqa: A002
    ) -> None: ...
    def failed(
        self,
        id: str,  # noqa: A002
        broker_attempt: int,
        code: str | None = None,
    ) -> RetryVerdict: ...
    def dead_lettered(
        self,
        id: str,  # noqa: A002
    ) -> None: ...
    def sink_failed(
        self,
        id: str,  # noqa: A002
        attempt: int,
    ) -> int: ...
    def tracked(self) -> RetriesTracked: ...

