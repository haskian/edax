class MemoryTransactor:
    def begin(self) -> int: ...
    def commit(self, tx: int) -> None: ...
    def rollback(self, tx: int) -> bool: ...
    def open_count(self) -> int: ...
    def load_events(self, tx: int, aggregate_id: str, after: int) -> list[EventEnvelope]: ...
    def append_events(
        self,
